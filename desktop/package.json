{
  "name": "minime-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "MiniMe - a glowing companion orb on your desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "cross-env MINIME_DEV_URL=http://localhost:4200 electron .",
    "start:debug": "cross-env MINIME_DEBUG=1 electron .",
    "start:opaque": "cross-env MINIME_OPAQUE=1 MINIME_DEBUG=1 electron .",
    "doctor": "node doctor.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^32.1.2"
  }
}
